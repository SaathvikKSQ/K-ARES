# K-AERS environment configuration (copy to .env and adjust)
# Never commit real secrets. See specs/security/security-requirements.md.

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# Postgres (Docker Compose default shown). For local dev without Docker:
# DATABASE_URL=sqlite:///./kaers.db
DATABASE_URL=postgresql+psycopg://kaers:kaers-dev-password@localhost:5432/kaers
POSTGRES_PASSWORD=kaers-dev-password

# --- Security ---
# REQUIRED in production: generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Initial admin bootstrap (created by `python -m app.db.seed`)
ADMIN_EMAIL=admin@kaers.dev
ADMIN_PASSWORD=change-me-immediately

# --- Storage / uploads ---
DATA_DIR=./data
MAX_UPLOAD_MB=10
MAX_DATASET_ROWS=20000

# --- Outbound integration safety ---
ALLOW_PRIVATE_TARGETS=false   # never enable in production
ADAPTER_CONNECT_TIMEOUT_S=10
ADAPTER_READ_TIMEOUT_S=60

# --- Ports (Docker Compose) ---
API_PORT=8001
WEB_PORT=5173

# --- Retention (days) ---
RETENTION_DAYS_ARTIFACTS=90
RETENTION_DAYS_EXPORTS=7
